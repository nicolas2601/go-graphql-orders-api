scalar Time

type User {
  id: ID!
  email: String!
  createdAt: Time!
}

type Product {
  id: ID!
  name: String!
  price: Float!
  stock: Int!
  createdAt: Time!
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

type OrderItem {
  # product se resuelve por su propio resolver (DataLoader): el modelo solo lleva ProductID.
  product: Product!
  quantity: Int!
  unitPrice: Float!
}

type Order {
  id: ID!
  # user se resuelve por su propio resolver (DataLoader): el modelo solo lleva UserID.
  user: User!
  items: [OrderItem!]!
  total: Float!
  status: OrderStatus!
  createdAt: Time!
}

type AuthPayload {
  accessToken: String!
  refreshToken: String!
  user: User!
}

type ProductPage {
  items: [Product!]!
  total: Int!
  page: Int!
  pageSize: Int!
  hasNextPage: Boolean!
}

type OrderPage {
  items: [Order!]!
  total: Int!
  page: Int!
  pageSize: Int!
  hasNextPage: Boolean!
}

input RegisterInput {
  email: String!
  password: String!
}

input LoginInput {
  email: String!
  password: String!
}

input ProductFilter {
  name: String
  minPrice: Float
  maxPrice: Float
}

input OrderItemInput {
  productId: ID!
  quantity: Int!
}

input CreateOrderInput {
  items: [OrderItemInput!]!
}

type Query {
  me: User
  products(filter: ProductFilter, page: Int = 1, pageSize: Int = 20): ProductPage!
  product(id: ID!): Product
  myOrders(page: Int = 1, pageSize: Int = 20): OrderPage!
  order(id: ID!): Order
}

type Mutation {
  register(input: RegisterInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  refreshToken(token: String!): AuthPayload!
  createOrder(input: CreateOrderInput!): Order!
  confirmOrder(id: ID!): Order!
  cancelOrder(id: ID!): Order!
}
