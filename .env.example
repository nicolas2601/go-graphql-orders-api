# Configuracion de la API de ordenes. Copiar a .env para docker compose.
# La app lee estas variables del entorno; .env solo se usa para la interpolacion de docker compose.

# Servidor
PORT=8080
APP_ENV=development            # development habilita playground e introspection; production es el default fail-safe
LOG_LEVEL=info                 # debug | info | warn | error
GRAPHQL_PLAYGROUND=true

# Base de datos (requerida)
DATABASE_URL=postgres://orders:orders@db:5432/orders?sslmode=disable

# JWT (JWT_SECRET es obligatorio en produccion)
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Password hashing
BCRYPT_COST=10

# Datos de prueba y limites
SEED_PRODUCTS=true
AUTH_RATE_LIMIT=10             # requests por minuto por IP en login/register

# Interpolacion de docker compose
API_PORT=8080
POSTGRES_PASSWORD=orders
